# Copy to .env (loaded automatically by `npm start` / `npm run dev`).
# In production, set these in your host's dashboard. Never commit real values.

# MongoDB connection string, e.g. from MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave unset in development to use an embedded local MongoDB (data in .mongo-data/).
MONGODB_URI=

# Database name inside the cluster (optional).
MONGODB_DB=brew-journal

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed (secure cookies, no embedded database).
NODE_ENV=development

PORT=3000
