<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Brew Journal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500&display=swap">
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>">
</head>
<body>
<header class="topbar"><div class="topbar-inner">
  <a class="brand" href="/">Brew Journal</a>
  <nav>
    <a href="/guide">Calculator</a>
    <a href="/water">Water guide</a>
    <% if (locals.user) { %>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <button class="link">Log out</button>
      </form>
    <% } else { %>
      <a href="/login">Log in</a>
    <% } %>
  </nav>
</div></header>
<main>
<% if (locals.flash) { %><p class="flash"><%= flash %></p><% } %>
